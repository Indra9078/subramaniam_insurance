# Copy to .env.local for local development, and add the same two values in Vercel.
# Both are public by design (the publishable key only has the access row level security allows).
# Never add the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
